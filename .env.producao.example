# =============================================================================
# ELO - .env de PRODUÇÃO (PythonAnywhere) - somente referências, NENHUM segredo
# =============================================================================
# No servidor, copie este arquivo para ".env" na raiz do projeto.
# Cada ${NOME} é substituído pelo valor da variável de ambiente do servidor com o mesmo
# nome. Os valores reais ficam SÓ no arquivo de segredos fora do projeto
# (/home/SEU_USUARIO/.elo-segredos.env, com chmod 600) - veja o README, seção "Publicação".
# Se uma variável não existir no servidor, o valor fica vazio e o sistema avisa ao iniciar.
# =============================================================================

# Segredos (valores vêm do servidor)
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_HOST=${DB_HOST}
DB_NAME=${DB_NAME}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_TOKEN_ENCRYPTION_KEY=${GOOGLE_TOKEN_ENCRYPTION_KEY}

# Configurações que não são secretas (podem ficar escritas aqui)
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=SEU_USUARIO.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://SEU_USUARIO.pythonanywhere.com
DJANGO_HTTPS=True
DJANGO_PROXY_HTTPS=True
DJANGO_HSTS_SECONDS=31536000
DB_PORT=3306
DJANGO_API_LIMITE=120/min
DJANGO_LOG_NIVEL=ERROR
GOOGLE_REDIRECT_URI=https://SEU_USUARIO.pythonanywhere.com/google/retorno/
