DJANGO_SECRET_KEY=$CHAVE_SECRETA_DJANGO
DJANGO_DEBUG=True

DB_NAME=$NOME_DO_BANCO
DB_USER=$USUARIO_DO_BANCO
DB_PASSWORD=$SENHA_DO_BANCO
DB_HOST=$HOST_DO_BANCO
