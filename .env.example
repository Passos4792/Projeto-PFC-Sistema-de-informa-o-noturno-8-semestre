# =============================================================================
# ELO - modelo de configuração (NUNCA coloque valores reais neste arquivo)
# =============================================================================
# Como usar:
#   1. Copie este arquivo para ".env" (ele está no .gitignore e nunca vai para o Git).
#   2. Preencha os valores. Gere as chaves com os comandos indicados abaixo.
#
# De onde o sistema lê as configurações (a primeira encontrada vence):
#   1. Variáveis definidas no próprio servidor (painel da hospedagem ou arquivo WSGI).
#   2. O arquivo indicado em ELO_ARQUIVO_ENV (permite guardar os segredos FORA da
#      pasta do projeto, ex.: ELO_ARQUIVO_ENV=/home/usuario/.elo-segredos.env).
#   3. Este ".env" na raiz do projeto (uso em desenvolvimento).
#
# Em produção (DJANGO_DEBUG=False) o sistema se recusa a iniciar se o banco estiver
# sem senha, usar o usuário "root", o HTTPS estiver desligado ou a chave do Google
# for inválida.
# =============================================================================

# Django
# -----------------------------------------------------------------------------
# Chave secreta (mínimo 50 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ATENÇÃO: não troque em produção. Ela protege o Authenticator (2FA), os códigos de
# recuperação e os navegadores confiáveis; se mudar, todos precisam reconfigurar o 2FA.
DJANGO_SECRET_KEY=
# True apenas no seu computador. Em produção: False.
DJANGO_DEBUG=False
# Endereços aceitos, separados por vírgula. Ex.: usuario.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS
# -----------------------------------------------------------------------------
# Vazio = automático (ligado em produção). Use True/False para forçar.
DJANGO_HTTPS=
# Em produção, após confirmar que o HTTPS funciona: 31536000 (1 ano).
DJANGO_HSTS_SECONDS=0
# True quando o site fica atrás de um proxy (PythonAnywhere, Nginx, Cloudflare).
# NÃO ative no seu computador: sem proxy, o IP poderia ser falsificado.
DJANGO_PROXY_HTTPS=False
# Endereço completo com https. Ex.: https://usuario.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# API e logs
# -----------------------------------------------------------------------------
DJANGO_API_LIMITE=120/min
DJANGO_LOG_ARQUIVO=
DJANGO_LOG_NIVEL=ERROR

# Banco de dados MySQL
# -----------------------------------------------------------------------------
DB_NAME=elo_db
# Em produção use um usuário próprio (no PythonAnywhere: o nome da sua conta), nunca "root".
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Google Agenda (opcional: deixe vazio para desativar a integração)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/retorno/
# Chave própria para criptografar os tokens do Google (diferente da DJANGO_SECRET_KEY). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
